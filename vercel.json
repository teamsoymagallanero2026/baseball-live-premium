{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/overlay",
      "destination": "/overlay.html"
    },
    {
      "source": "/control",
      "destination": "/control.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
